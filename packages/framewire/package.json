{
  "name": "framewire",
  "version": "0.1.0",
  "description": "Typed, tiny messaging between a host page and the iframe it embeds.",
  "keywords": [
    "iframe",
    "postMessage",
    "embed",
    "widget",
    "cross-origin",
    "typed",
    "messaging",
    "resize"
  ],
  "homepage": "https://framewire.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NwosaEmeka/framewire.git",
    "directory": "packages/framewire"
  },
  "bugs": "https://github.com/NwosaEmeka/framewire/issues",
  "author": "Nwosa Emeka",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/size.json"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "unpkg": "./dist/framewire.global.js",
  "jsdelivr": "./dist/framewire.global.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "host": [
        "./dist/host.d.ts"
      ],
      "frame": [
        "./dist/frame.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./host": {
      "import": {
        "types": "./dist/host.d.ts",
        "default": "./dist/host.js"
      },
      "require": {
        "types": "./dist/host.d.cts",
        "default": "./dist/host.cjs"
      }
    },
    "./frame": {
      "import": {
        "types": "./dist/frame.d.ts",
        "default": "./dist/frame.js"
      },
      "require": {
        "types": "./dist/frame.d.cts",
        "default": "./dist/frame.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../../' + f, f)\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
